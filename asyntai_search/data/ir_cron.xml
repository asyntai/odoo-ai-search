<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Re-ask Asyntai whether the bar may render.

         Odoo has a scheduler of its own, so unlike our Joomla and OpenCart
         extensions this one never checks from a visitor's page. The bar
         switches itself off when the monthly allowance runs out, and back on
         when it resets, within this interval. -->
    <record id="ir_cron_asyntai_search_refresh" model="ir.cron">
        <field name="name">Asyntai AI Search: refresh status</field>
        <field name="model_id" ref="model_asyntai_search"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
